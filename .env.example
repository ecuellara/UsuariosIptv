# Variables del frontend (Vite). Todo lo que empieza con VITE_ se publica en el bundle:
# aquí van SOLO la URL del proyecto y la clave publicable. Nunca service_role.

# --- Desarrollo local (supabase start) ---
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=<publishable_key_local>

# --- Producción (Cloudflare Pages / Vercel) ---
# VITE_SUPABASE_URL=https://<project-ref>.supabase.co
# VITE_SUPABASE_ANON_KEY=sb_publishable_<...>
